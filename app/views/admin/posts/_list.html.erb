<div class="container">
  <div class="row d-none d-md-block">
    <!-- 大画面用のテーブル -->
    <table class="table table-bordered">
      <thead style="background-color: #FFDBC9;">
        <tr>
          <th scope="col">ユーザー</th>
          <th scope="col">タイトル</th>
          <th scope="col">本文</th>
          <th scope="col">投稿画像</th>
          <th scope="col">ステータス</th>
          <th scope="col">タグ</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= link_to image_tag(post.user.get_profile_image(100, 100)), admin_user_path(post.user_id) %></td>
            <td><%= link_to post.title, admin_post_path(post.id) %></td>
            <td><%= truncate(post.body, length: 50) %></td>
            <td><%= image_tag(post.get_image, size: "100x100") %></td>
            <td>
              <% if post.status == "active" %>
                <strong class="text-success">有効</strong>
              <% else %>
                <strong class="text-muted">無効</strong>
              <% end %>
            </td>
            <td><%= post.tag_list %></td>
            <td><%= link_to "Edit", edit_admin_post_path(post.id), class: 'btn btn-sm btn-success' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- 小画面用のカードレイアウト -->
  <div class="d-md-none">
    <% @posts.each do |post| %>
      <div class="card mb-3">
        <div class="card-header">
          <%= link_to image_tag(post.user.get_profile_image(50, 50), class: "rounded-circle"), admin_user_path(post.user_id) %>
          <strong><%= post.title %></strong>
        </div>
        <div class="card-body">
          <p><%= truncate(post.body, length: 100) %></p>
          <%= image_tag(post.get_image, size: "100x100") %>
          <p>
            <strong>ステータス:</strong>
            <% if post.status == "active" %>
              <span class="text-success">有効</span>
            <% else %>
              <span class="text-muted">無効</span>
            <% end %>
          </p>
          <p><strong>タグ:</strong> <%= post.tag_list %></p>
          <%= link_to "Edit", edit_admin_post_path(post.id), class: 'btn btn-sm btn-success' %>
        </div>
      </div>
    <% end %>
  </div>
  <%= paginate @posts %>
</div>