<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-12">
      <div class="sort-options mb-3"></div>

      <!-- 大画面用テーブル -->
      <table class="table table-striped table-bordered d-none d-md-table">
        <thead class="px-4 my-4" style="background-color: #FFDBC9;">
          <tr>
            <th scope="col">ユーザー</th>
            <th scope="col">タイトル</th>
            <th scope="col">本文</th>
            <th scope="col">投稿画像</th>
            <th scope="col">タグ</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <!-- データ表示部分 -->
          <% posts.each do |post| %>
            <tr id="post-<%= post.id %>">
              <td><%= link_to image_tag(post.user.get_profile_image(100, 100), class: "rounded-circle mb-3"), user_path(post.user_id) %></td>
              <td><%= link_to post.title, post_path(post.id) %></td>
              <td><%= truncate(post.body) %></td>
              <td><%= image_tag(post.get_image, size: "100x100") %></td>
              <td>
                <% post.tags.each do |tag| %>
                  <%= link_to tag.name, tag_path(tag), class: "badge bg-info text-white m-1" %>
                <% end %>
              </td>
              <td><%= post.favorites.count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <!-- 小画面用カード形式 -->
      <div class="d-md-none">
        <% posts.each do |post| %>
          <div class="card mb-3">
            <div class="card-header">
              <%= link_to image_tag(post.user.get_profile_image(50, 50), class: "rounded-circle"), user_path(post.user_id) %>
              <%= post.title %>
            </div>
            <div class="card-body">
              <p><%= truncate(post.body) %></p>
              <%= image_tag(post.get_image, size: "100x100") %>
              <p>
                <% post.tags.each do |tag| %>
                  <%= link_to tag.name, tag_path(tag), class: "badge bg-info text-white m-1" %>
                <% end %>
              </p>
              <p><%= post.favorites.count %></p>
            </div>
          </div>
        <% end %>
      </div>

      <%= paginate posts %>
    </div>
  </div>
</div>