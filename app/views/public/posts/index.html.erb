<style>
  /* サイドバーを固定 */
  .sticky-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 100vh;
    overflow-y: auto;
    background-color: #f8f9fa;
    padding: 20px;
    z-index: 1000;
  }

  /* メインコンテンツの調整 */
  .content-area {
    margin-left: 270px;
  }

  /* レスポンシブ対応 - 小さな画面の場合のレイアウト */
  @media (max-width: 768px) {
    .sticky-sidebar {
      position: relative;
      width: 100%;
      height: auto;
      z-index: auto;
    }

    .content-area {
      margin-left: 0;
      padding-top: 20px;
    }
  }
</style>


<div class="container">
  <div class="row">
    <div class="col-md-3 sticky-sidebar">
      <%= render 'public/users/sidebar', user: @user %>
      <%= render 'public/posts/sidebar', post: @new_post %>
    </div>
    
    <div class="col-md-9">
      <h2 class="ml-3 mt-3">投稿一覧</h2>
      <%= form_tag(posts_path, method: "get", class: "form-inline") do %>
        <%= select_tag :sort, options_for_select([['新しい順', 'newest'], ['古い順', 'oldest'], ['いいね順', 'most_liked']], params[:sort]), class: 'form-control mr-2' %>
        <%= submit_tag '変更', class: 'btn btn-primary' %>
      <% end %>
      <%= render 'public/posts/list', posts: @posts %>
    </div>
  </div>
</div>
